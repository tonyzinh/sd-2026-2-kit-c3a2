# Copiar para .env e OPCIONAL: `docker compose up --build` funciona sem ele.
# Nunca versione o .env.

# Seguranca (em producao os valores de desenvolvimento sao recusados)
JWT_SEGREDO=dev-segredo-jwt-apenas-para-uso-local
TOKEN_INTERNO=dev-token-interno
USUARIOS=demo:demo-local
LIMITE_POR_MINUTO=60

# Retencao dos dados (LGPD)
RETENCAO_HORAS=24

# LLM: deixe LLM_API_KEY vazia para o modo simulado (offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=8

# Resiliencia
HTTP_TIMEOUT=5
HTTP_TENTATIVAS=3
TIMEOUT_PERGUNTAR=40
BREAKER_LIMITE_FALHAS=3
BREAKER_ESPERA=20

# Rastreamento: o compose ja aponta para o Jaeger local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_EXPORTER_OTLP_HEADERS=
